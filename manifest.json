{
    "manifest_version": 3,
    "name": "WhatsApp Message Blur",
    "version": "1.0",
    "description": "Blur messages from specific WhatsApp contacts to maintain privacy",
    "permissions": ["activeTab", "storage", "contextMenus"],
    "host_permissions": ["https://web.whatsapp.com/*"],
    "action": {
        "default_popup": "popup.html",
        "default_title": "WhatsApp Blur Settings"
    },
    "content_scripts": [
        {
            "matches": ["https://web.whatsapp.com/*"],
            "js": [
                "content-state.js",
                "blur-styles.js",
                "whatsapp-dom.js",
                "blur-controller.js",
                "blur-contact.js",
                "user-scanner.js",
                "user-bulk-actions.js",
                "wpp-export.js",
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
